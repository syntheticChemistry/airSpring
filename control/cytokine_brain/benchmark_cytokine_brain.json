  "validation_checks": {
    "input_normalization": {
      "description": "CytokineObservation feature normalization bounds",
      "test_cases": [
        {
          "label": "Time normalization (48h / 720)",
          "time_hours": 48.0,
          "expected_normalized": 0.066667,
          "tolerance": 0.0001
        },
        {
          "label": "IL-31 normalization (250 pg/mL / 500)",
          "il31_level": 250.0,
          "expected_normalized": 0.5,
          "tolerance": 1e-06
        },
        {
          "label": "IL-4 normalization (100 pg/mL / 200)",
          "il4_level": 100.0,
          "expected_normalized": 0.5,
          "tolerance": 1e-06
        },
        {
          "label": "IL-13 normalization (60 pg/mL / 200)",
          "il13_level": 60.0,
          "expected_normalized": 0.3,
          "tolerance": 1e-06
        },
        {
          "label": "Pruritus normalization (7/10)",
          "pruritus_score": 7.0,
          "expected_normalized": 0.7,
          "tolerance": 1e-06
        },
        {
          "label": "TEWL normalization (45 g/m\u00b2/h / 100)",
          "tewl": 45.0,
          "expected_normalized": 0.45,
          "tolerance": 1e-06
        },
        {
          "label": "Pielou passthrough (0.85)",
          "pielou_evenness": 0.85,
          "expected_normalized": 0.85,
          "tolerance": 1e-06
        }
      ]
    },
    "prediction_regime": {
      "description": "CytokinePrediction \u2192 AndersonRegime classification",
      "test_cases": [
        {
          "label": "Healthy skin (localized)",
          "signal_extent": 0.1,
          "w_predicted": 0.3,
          "barrier_integrity": 0.9,
          "expected_regime": "Localized"
        },
        {
          "label": "AD flare (extended)",
          "signal_extent": 0.9,
          "w_predicted": 0.8,
          "barrier_integrity": 0.1,
          "expected_regime": "Extended"
        },
        {
          "label": "Transition state (critical)",
          "signal_extent": 0.5,
          "w_predicted": 0.5,
          "barrier_integrity": 0.5,
          "expected_regime": "Critical"
        },
        {
          "label": "High signal but intact barrier (critical)",
          "signal_extent": 0.8,
          "w_predicted": 0.6,
          "barrier_integrity": 0.8,
          "expected_regime": "Critical"
        },
        {
          "label": "Low signal but breached barrier (critical)",
          "signal_extent": 0.2,
          "w_predicted": 0.4,
          "barrier_integrity": 0.2,
          "expected_regime": "Critical"
        }
      ]
    },
    "brain_lifecycle": {
      "description": "CytokineBrain observe \u2192 train \u2192 predict \u2192 export \u2192 import lifecycle",
      "test_cases": [
        {
          "label": "10-observation training cycle",
          "n_observations": 10,
          "min_training_points": 5,
          "expected_trained_after": true,
          "expected_prediction_finite": true,
          "expected_signal_extent_range": [
            0.0,
            1.0
          ],
          "expected_w_range": [
            0.0,
            1.0
          ],
          "expected_barrier_range": [
            0.0,
            1.0
          ]
        },
        {
          "label": "Insufficient data (3 obs, min 5)",
          "n_observations": 3,
          "min_training_points": 5,
          "expected_trained_after": false
        },
        {
          "label": "Shell export/import roundtrip",
          "n_observations": 8,
          "min_training_points": 5,
          "expected_trained_after": true,
          "expected_export_nonempty": true,
          "expected_import_trained": true
