    "edge_cases": {
      "description": "Boundary conditions and physical constraints",
      "test_cases": [
        {
          "label": "Zero Ra \u2192 zero ET\u2080",
          "tmin": 20.0,
          "tmax": 30.0,
          "ra_mm_day": 0.0,
          "check": "zero"
        },
        {
          "label": "Tmax = Tmin \u2192 zero ET\u2080 (no diurnal range)",
          "tmin": 25.0,
          "tmax": 25.0,
          "ra_mm_day": 15.0,
          "check": "zero"
        },
        {
          "label": "Tmax < Tmin \u2192 clamped to zero",
          "tmin": 30.0,
          "tmax": 20.0,
          "ra_mm_day": 15.0,
          "check": "zero"
        },
        {
          "label": "Very hot day \u2192 positive ET\u2080",
          "tmin": 30.0,
          "tmax": 45.0,
          "ra_mm_day": 16.0,
          "check": "positive"
        },
        {
          "label": "Subfreezing Tmean \u2192 still positive if Ra > 0 and \u0394T > 0",
          "tmin": -10.0,
          "tmax": 2.0,
          "ra_mm_day": 5.0,
          "check": "positive"
        }
      ]
