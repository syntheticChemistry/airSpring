          "label": "5-species cover crop mix (120,85,45,30,20)",
          "counts": [
            120,
            85,
            45,
            30,
            20
          ],
          "expected": 1.4192,
          "tolerance": 0.0001
        },
        {
          "label": "Monoculture (300,0,0,0,0)",
          "counts": [
            300,
            0,
            0,
            0,
            0
          ],
          "expected": 0.0,
          "tolerance": 1e-10
        },
        {
          "label": "Perfectly even 5-species (60 each)",
          "counts": [
            60,
            60,
            60,
            60,
            60
          ],
          "expected": 1.609438,
          "tolerance": 0.0001
        },
        {
          "label": "Sparse community (100,50,1,1,1,1,0,0,0,0)",
          "counts": [
            100,
            50,
            1,
            1,
